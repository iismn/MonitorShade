<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MonitorShade;assembly=MonitorShade"
 FontFamily="Pretendard, Segoe UI, Malgun Gothic" FontSize="14" Foreground="{DynamicResource Text}" Background="{DynamicResource Page}"
 UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
 <UserControl.Resources>
  <SolidColorBrush x:Key="Page" Color="#202020"/><SolidColorBrush x:Key="Card" Color="#2B2B2B"/>
  <SolidColorBrush x:Key="Map" Color="#1C1C1C"/><SolidColorBrush x:Key="Input" Color="#343434"/>
  <SolidColorBrush x:Key="Stroke" Color="#494949"/><SolidColorBrush x:Key="Text" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="Muted" Color="#C2C2C2"/><SolidColorBrush x:Key="Accent" Color="#60CDFF"/>
  <SolidColorBrush x:Key="AccentText" Color="#101010"/><SolidColorBrush x:Key="Hover" Color="#404040"/>
  <SolidColorBrush x:Key="Monitor" Color="#373737"/><SolidColorBrush x:Key="Selection" Color="#0078D4"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Input}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="16,0"/><Setter Property="Height" Value="36"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="RadioButton" x:Key="UnitButton">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Width" Value="56"/><Setter Property="Height" Value="36"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Surface" Background="Transparent" CornerRadius="10" BorderThickness="1" BorderBrush="Transparent">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Text}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Height" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="12,0"/>
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Input}"/>
   <Setter Property="CaretBrush" Value="{DynamicResource Text}"/><Setter Property="SelectionBrush" Value="{DynamicResource Selection}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
     <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Surface" Property="BorderThickness" Value="1,1,1,2"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider"><Setter Property="local:SliderFeedback.Enabled" Value="True"/>
   <Setter Property="Height" Value="36"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid x:Name="SliderVisual" VerticalAlignment="Center" Background="Transparent" Opacity="0.74">
     <Grid.Effect><DropShadowEffect x:Name="SliderGlow" Color="{DynamicResource AccentColor}" BlurRadius="19" ShadowDepth="0" Opacity="0"/></Grid.Effect>
     <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal">
      <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{DynamicResource Accent}" Height="6" CornerRadius="3"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Width="18" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource Accent}"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{DynamicResource Soft}" Height="6" CornerRadius="3"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
    <ControlTemplate.Triggers>

     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Width" Value="48"/><Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Track" Height="24" CornerRadius="12" BorderBrush="{DynamicResource Muted}" BorderThickness="1" Background="Transparent">
     <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="4,0,0,0"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentText}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderThickness" Value="2"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Text}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="12,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" CornerRadius="10" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Selection}"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Height" Value="36"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Input}"/>
   <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource Input}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="10"><Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Text}" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
      <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="4">
       <ScrollViewer MaxHeight="280"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </Border>
     </Popup>
     <Border x:Name="FocusBorder" IsHitTestVisible="False" CornerRadius="10" BorderThickness="0" BorderBrush="{DynamicResource Accent}"/>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusBorder" Property="BorderThickness" Value="1,1,1,2"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Border" x:Key="CardStyle"><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Padding" Value="24,20"/></Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Tile" Background="{DynamicResource Input}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="10" Padding="12,8" MinWidth="104">
     <ContentPresenter HorizontalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Text}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
     <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Muted}" Opacity="0.4" Margin="3,2" CornerRadius="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock" x:Key="Caption"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,4,0,0"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="TextBlock" x:Key="Glyph"><Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="20"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Width" Value="40"/></Style>
  <Style TargetType="Expander">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
    <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" Cursor="Hand" Height="28">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
      <Border x:Name="HeaderBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10"><Grid>
       <ContentPresenter VerticalAlignment="Center" Margin="0,0,28,0"/>
       <Path x:Name="Chevron" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Text}" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" RenderTransformOrigin="0.5,0.5"/>
      </Grid></Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="Opacity" Value="0.8"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed"/>
   </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="RadioButton" x:Key="NavigationItem">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Height" Value="46"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Surface" CornerRadius="10" Background="Transparent"><Grid>
     <Border x:Name="Indicator" Width="3" Height="18" HorizontalAlignment="Left" Background="Transparent" CornerRadius="2"/>
     <ContentPresenter Margin="16,0" VerticalAlignment="Center"/>
    </Grid></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Card}"/><Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Accent}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid><Grid.Background><RadialGradientBrush Center="0.9,0" GradientOrigin="0.9,0" RadiusX="1" RadiusY="0.9"><GradientStop Color="{DynamicResource AuraColor}" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></RadialGradientBrush></Grid.Background><Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0" Padding="12,24,8,16">
   <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="MonitorShade" FontWeight="SemiBold" FontSize="16" Margin="12,0,0,25"/>
    <StackPanel>
     <RadioButton x:Name="NavBrightness" GroupName="Navigation" Style="{StaticResource NavigationItem}" AutomationProperties.Name="모니터 밝기 메뉴"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE706;" Style="{StaticResource Glyph}" Width="32"/><TextBlock Text="밝기" VerticalAlignment="Center"/></StackPanel></RadioButton>
     <RadioButton x:Name="NavProtection" GroupName="Navigation" IsChecked="True" Style="{StaticResource NavigationItem}" AutomationProperties.Name="화면 보호 메뉴"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" Width="32"/><TextBlock Text="화면 보호" VerticalAlignment="Center"/></StackPanel></RadioButton>
     <RadioButton x:Name="NavLayout" GroupName="Navigation" Style="{StaticResource NavigationItem}" AutomationProperties.Name="창 배치 메뉴"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A9;" Style="{StaticResource Glyph}" Width="32"/><TextBlock Text="창 배치" VerticalAlignment="Center"/></StackPanel></RadioButton>

     <RadioButton x:Name="NavShortcuts" GroupName="Navigation" Style="{StaticResource NavigationItem}" AutomationProperties.Name="단축키 메뉴"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE765;" Style="{StaticResource Glyph}" Width="32"/><TextBlock Text="단축키" VerticalAlignment="Center"/></StackPanel></RadioButton>
     <RadioButton x:Name="NavGeneral" GroupName="Navigation" Style="{StaticResource NavigationItem}" AutomationProperties.Name="일반 메뉴"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Width="32"/><TextBlock Text="일반" VerticalAlignment="Center"/></StackPanel></RadioButton>
     <RadioButton x:Name="NavHelp" GroupName="Navigation" Style="{StaticResource NavigationItem}" AutomationProperties.Name="도움말 메뉴"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE897;" Style="{StaticResource Glyph}" Width="32"/><TextBlock Text="도움말" VerticalAlignment="Center"/></StackPanel></RadioButton>
    </StackPanel>
   </DockPanel>
  </Border>
  <DockPanel Grid.Column="1" LastChildFill="True">
   <Border DockPanel.Dock="Bottom" Background="Transparent" BorderBrush="{DynamicResource Stroke}" BorderThickness="0" Padding="28,16">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="Status" Text="준비됨" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
     <Button x:Name="Exit" Grid.Column="1" Content="종료" Margin="12,0,8,0"/>
     <Button x:Name="Start" Grid.Column="2" Content="저장하고 감시" MinWidth="128" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" BorderBrush="{DynamicResource Accent}"/>
    </Grid>
   </Border>
   <Grid>
    <ScrollViewer x:Name="ProtectionPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,24,28,24">
     <TextBlock Text="화면 보호" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24"/>
     <Border Background="{DynamicResource Map}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="20,12,20,16">
      <Grid><Grid.RowDefinitions><RowDefinition Height="156"/><RowDefinition Height="36"/></Grid.RowDefinitions>
       <Canvas x:Name="Map" ClipToBounds="True" Focusable="False"/>
       <Button x:Name="Refresh" Grid.Row="1" Content="새로고침" HorizontalAlignment="Right"/>
      </Grid>
     </Border>
     <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="228"/></Grid.ColumnDefinitions>
      <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="대상 모니터"/><TextBlock x:Name="DisplayDetail" Style="{StaticResource Caption}"/></StackPanel>
      <ListBox x:Name="Displays" Grid.Column="2" SelectionMode="Multiple" BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="감시할 모니터 다중 선택">
       <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
       <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid></Border>
     <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="&#xE916;" Style="{StaticResource Glyph}"/><TextBlock Grid.Column="1" Text="대기 시간" VerticalAlignment="Center"/>
      <Grid Grid.Column="2" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="12"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
       <TextBox x:Name="Amount" Text="120" MaxLength="5" TextAlignment="Right" AutomationProperties.Name="대기 시간 값" ToolTip="1 이상의 정수를 입력하세요."/>
       <Border Grid.Column="2" Background="{DynamicResource Input}" CornerRadius="10"><StackPanel Orientation="Horizontal"><RadioButton x:Name="Seconds" GroupName="TimeUnit" Content="초" IsChecked="True" Style="{StaticResource UnitButton}" AutomationProperties.Name="초 단위"/><RadioButton x:Name="Minutes" GroupName="TimeUnit" Content="분" Style="{StaticResource UnitButton}" AutomationProperties.Name="분 단위"/></StackPanel></Border>
      </Grid>
     </Grid></Border>
     <TextBlock x:Name="Validation" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>
     <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xEB9F;" Style="{StaticResource Glyph}"/><TextBlock Grid.Column="1" Text="배경화면 움직임 무시" VerticalAlignment="Center"/><CheckBox x:Name="IgnoreWallpaper" Grid.Column="2" VerticalAlignment="Center" AutomationProperties.Name="배경화면 움직임 무시"/></Grid></Border>
     <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE708;" Style="{StaticResource Glyph}"/><TextBlock Grid.Column="1" Text="강제 검은 화면 단축키" VerticalAlignment="Center"/><CheckBox x:Name="ManualEnabled" Grid.Column="2" VerticalAlignment="Center" AutomationProperties.Name="강제 검은 화면 단축키 사용"/></Grid>
      <Grid Margin="40,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="228"/></Grid.ColumnDefinitions><TextBlock Text="Ctrl + Alt + F9" VerticalAlignment="Center"/><ComboBox x:Name="ManualFirst" Grid.Column="1" AutomationProperties.Name="F9 강제 가림 대상 모니터"/></Grid>
      <Grid Margin="40,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="228"/></Grid.ColumnDefinitions><TextBlock Text="Ctrl + Alt + F10" VerticalAlignment="Center"/><ComboBox x:Name="ManualSecond" Grid.Column="1" AutomationProperties.Name="F10 강제 가림 대상 모니터"/></Grid>
      <Button x:Name="ApplyManual" Content="적용" HorizontalAlignment="Right" Margin="0,12,0,0" AutomationProperties.Name="강제 검은 화면 단축키 적용"/>
      <TextBlock x:Name="ManualStatus" Style="{StaticResource Caption}" Margin="40,8,0,0" Visibility="Collapsed"/>
     </StackPanel></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="LayoutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,24,28,24">
     <TextBlock Text="창 배치" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24"/>
     <Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="&#xE765;" Style="{StaticResource Glyph}"/><TextBlock Grid.Column="1" Text="창 배치 단축키" VerticalAlignment="Center"/>
      <CheckBox x:Name="LayoutEnabled" Grid.Column="2" VerticalAlignment="Center" AutomationProperties.Name="창 배치 단축키 사용"/>
     </Grid></Border>
     <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="&#xE9A6;" Style="{StaticResource Glyph}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="중앙 창 너비"/><TextBlock Text="Win + Del · 16:9" Style="{StaticResource Caption}"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBox x:Name="CenterPercent" Width="80" MaxLength="3" TextAlignment="Right" AutomationProperties.Name="중앙 창 너비 백분율"/><TextBlock Text="%" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
     </Grid></Border>
     <TextBlock x:Name="CenterValidation" Foreground="{DynamicResource Accent}" Text="10~100 사이의 정수를 입력하세요." FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>
     <Button x:Name="ApplyLayout" Content="적용" HorizontalAlignment="Left" MinWidth="88" Margin="0,16,0,0" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" BorderBrush="{DynamicResource Accent}"/>
     <TextBlock x:Name="LayoutStatus" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="BrightnessPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,24,28,20">
