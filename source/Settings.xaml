     <TextBlock x:Name="BrightnessStatus" Style="{StaticResource Caption}" Margin="0,0,0,12" Visibility="Collapsed"/>
     <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE71B;" Style="{StaticResource Glyph}" Width="24" FontSize="18"/><TextBlock Grid.Column="1" Text="두 모니터 밝기 동기화" VerticalAlignment="Center"/><CheckBox x:Name="BrightnessSync" Grid.Column="2" VerticalAlignment="Center" AutomationProperties.Name="선택한 모니터 밝기 동기화"/></Grid></Border>
