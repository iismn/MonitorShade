     <Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="밝기 단축키 사용" VerticalAlignment="Center"/><CheckBox x:Name="BrightnessHotkeys" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="밝기 단축키 사용"/></Grid></Border>
     <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
       <TextBlock Text="키 조합" VerticalAlignment="Center"/>
       <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="보조키" Style="{StaticResource Caption}" Margin="0,0,0,6"/><ComboBox x:Name="BrightnessModifier" AutomationProperties.Name="밝기 단축키 보조키"/></StackPanel>
       <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="낮추기" Style="{StaticResource Caption}" Margin="0,0,0,6"/><ComboBox x:Name="BrightnessDown" AutomationProperties.Name="밝기 낮추기 키"/></StackPanel>
       <StackPanel Grid.Column="3"><TextBlock Text="높이기" Style="{StaticResource Caption}" Margin="0,0,0,6"/><ComboBox x:Name="BrightnessUp" AutomationProperties.Name="밝기 높이기 키"/></StackPanel>
      </Grid>
      <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions><TextBlock Text="조절 대상" VerticalAlignment="Center"/><ComboBox x:Name="BrightnessTarget" Grid.Column="1" AutomationProperties.Name="밝기 단축키 대상"/></Grid>
      <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><TextBlock Text="조절 간격" VerticalAlignment="Center"/><TextBox x:Name="BrightnessStep" Grid.Column="1" TextAlignment="Right" MaxLength="2" AutomationProperties.Name="밝기 변경 간격"/><TextBlock Grid.Column="2" Text="%" Margin="10,0,0,0" VerticalAlignment="Center"/></Grid>
     </StackPanel></Border>
     <TextBlock x:Name="ShortcutsStatus" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
     <Button x:Name="ApplyBrightness" Content="저장" AutomationProperties.Name="밝기 단축키 설정 저장" HorizontalAlignment="Left" MinWidth="88" Margin="0,16,0,0" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" BorderBrush="{DynamicResource Accent}"/>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="GeneralPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,24,28,24">
     <TextBlock Text="일반" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24"/>
     <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><TextBlock Text="시간별 색상" VerticalAlignment="Center"/><ComboBox x:Name="AppearanceMode" Grid.Column="1" AutomationProperties.Name="시간별 색상 모드"/></Grid></Border>
     <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="창 뒤 배경 블러" VerticalAlignment="Center"/><CheckBox x:Name="UseBackdrop" Grid.Column="1" AutomationProperties.Name="창 뒤 배경 블러"/></Grid></Border>
     <TextBlock x:Name="AppearanceStatus" Style="{StaticResource Caption}" Margin="0,0,0,12"/>

     <Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="&#xE7E8;" Style="{StaticResource Glyph}"/><TextBlock Grid.Column="1" Text="로그인 시 자동 실행" VerticalAlignment="Center"/>
      <CheckBox x:Name="AutoStart" Grid.Column="2" VerticalAlignment="Center" AutomationProperties.Name="Windows 로그인 시 자동 실행 및 감시"/>
     </Grid></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="HelpPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,24,28,24">
     <TextBlock Text="도움말" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24"/>
     <Border Style="{StaticResource CardStyle}"><Expander x:Name="HelpProtection" Header="화면 보호" Foreground="{DynamicResource Text}" IsExpanded="True"><StackPanel Margin="0,12,0,0">
      <TextBlock Text="모니터 배치 그림이나 모니터 버튼을 눌러 여러 대를 선택할 수 있습니다. 화면 내용이 설정한 시간 동안 변하지 않으면 해당 모니터만 검게 가립니다. 대기 시간은 초 또는 분으로 지정합니다." Style="{StaticResource Caption}" LineHeight="20"/>
      <TextBlock Text="마우스가 있는 화면은 가리지 않으며, 다른 화면의 감시는 계속됩니다. 가려진 화면에 마우스가 들어오거나 뒤쪽 화면 내용이 바뀌면 자동으로 복귀합니다." Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="20"/>
      <TextBlock Text="‘배경화면 움직임 무시’를 켜면 앱 창 영역만 비교합니다. 작은 창 주위에 보이는 Lively 배경과 바탕 화면 아이콘·작업표시줄의 변화는 무시하며, 앱 창의 내용·위치·크기·열림·닫힘은 감지합니다. 앱이 없는 화면도 대기 시간 후 검게 가립니다. 배경 애니메이션만으로는 다시 켜지지 않으며 마우스가 들어오면 바로 복귀합니다." Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="20"/>
      <TextBlock Text="앱 내부 영상은 계속 변화로 감지합니다. 반투명 앱을 통해 배경이 비치는 경우에는 감지가 계속될 수 있습니다. 창 그림자와 둥근 모서리의 작은 영역은 비교에서 제외합니다. 옵션을 끄면 배경을 포함한 화면 전체를 비교합니다. Lively 재생이나 설정은 변경하지 않습니다." Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="20"/>
      <TextBlock Text="설정 창을 열면 화면 보호가 일시정지합니다. ‘저장하고 감시’를 누르면 설정을 저장하고 트레이로 돌아갑니다. 창 배치와 밝기 단축키는 화면 보호를 일시정지해도 사용할 수 있습니다." Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="20"/>
      <TextBlock Text="강제 검은 화면은 Ctrl + Alt + F9 / F10으로 켜고 끕니다. ‘화면 보호’에서 각 키의 대상 모니터를 고른 뒤 ‘적용’을 누르세요. 기본 대상은 각각 모니터 1 / 2이며, 자동 감시를 중지해도 사용할 수 있습니다." Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="20"/>
      <TextBlock Text="강제 가림은 앱·배경의 움직임을 무시하며, 마우스가 해당 화면으로 들어오거나 같은 단축키를 다시 누르면 해제됩니다. 시작할 때 마우스가 이미 그 화면에 있었다면 밖으로 나갔다가 다시 들어올 때 해제됩니다. 해제 후에는 자동 감시의 대기 시간을 처음부터 셉니다." Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="20"/>
      <TextBlock Text="Ctrl + Alt + F11로 설정을 열거나 Ctrl + Alt + F12로 일시정지하면 모든 강제 가림이 해제됩니다. 잠금·절전·화면 접근 중단·모니터 구성 변경 시에도 해제되며 자동으로 다시 강제 가리지 않습니다." Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="20"/>
     </StackPanel></Expander></Border>
     <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0"><Expander x:Name="HelpLayout" Header="창 배치" Foreground="{DynamicResource Text}"><StackPanel Margin="0,12,0,0">
      <TextBlock Text="Win + ← / →  ·  왼쪽 / 오른쪽부터 너비 1/2 → 2/3 → 최대화&#x0a;Win + ↑ / ↓  ·  위쪽 / 아래쪽부터 높이 1/2 → 2/3 → 최대화&#x0a;Win + Del  ·  16:9 중앙 배치 ↔ 최대화" TextWrapping="Wrap" LineHeight="26"/>
      <TextBlock Text="같은 키를 반복해서 누르면 크기가 순환합니다. 활성 창이 있는 모니터에서 동작하며, 다른 방향을 누르거나 창을 직접 옮기면 1/2부터 다시 시작합니다." Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="20"/>
      <TextBlock Text="중앙 창 너비는 모니터 작업 영역의 너비 기준입니다. 높이를 넘으면 16:9를 유지해 줄입니다. 최대화는 작업표시줄과 창 제목 표시줄을 남깁니다." Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="20"/>
      <TextBlock Text="창 배치 단축키를 켜면 Win + 방향키의 기본 동작을 대체합니다. Ctrl·Alt·Shift를 추가한 Windows 단축키는 유지됩니다. 고정 크기 창이나 관리자 권한 앱에서는 배치가 제한될 수 있습니다." Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="20"/>
     </StackPanel></Expander></Border>
     <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0"><Expander x:Name="HelpBrightness" Header="모니터 밝기" Foreground="{DynamicResource Text}"><StackPanel Margin="0,12,0,0">
      <TextBlock Text="DDC/CI로 모니터 자체 밝기를 조절합니다. 슬라이더와 − / + 버튼은 바로 적용되며, 모니터에서 값을 다시 읽어 확인합니다. 앱을 시작하거나 새로고침하는 것만으로 밝기가 바뀌지는 않습니다." Style="{StaticResource Caption}" LineHeight="20"/>
      <TextBlock Text="‘밝기 동기화’를 켜면 ‘함께 조절’로 선택한 모니터에 같은 밝기 %를 적용합니다. 어느 쪽 슬라이더를 움직여도 묶인 모니터가 같은 값으로 바뀝니다. 동기화와 그룹 선택은 즉시 저장되며, 스위치만 켜는 것으로 실제 밝기는 바뀌지 않습니다." Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="20"/>
      <TextBlock Text="기본 단축키는 오른쪽 Alt + F2 / F3(5% 낮추기 / 높이기)입니다. 동기화 중에는 높이기는 가장 밝은 값, 낮추기는 가장 어두운 값을 기준으로 합니다. 예: 40·60에서 높이기 → 65·65, 낮추기 → 35·35. 동기화를 끄면 각각의 밝기에서 조절합니다. ‘마우스가 있는 모니터’도 묶인 대상이면 그룹 전체를 조절합니다." Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="20"/>
      <TextBlock Text="보조키, 낮추기·높이기 키, 조절 간격과 단축키 대상은 ‘저장’ 또는 ‘저장하고 감시’로 저장합니다. 키를 계속 누르고 있어도 한 번만 조절합니다. Ctrl+Alt·AltGr의 F9~F12는 공통 단축키로 예약되어 있습니다. 한국어 키보드에서 오른쪽 Alt 조합이 동작하지 않으면 보조키를 변경하세요." Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="20"/>
      <TextBlock Text="nit는 Windows가 보고한 피크·전체 화면 휘도 메타데이터이며 현재 밝기의 실측값이 아닙니다. 읽기 전용으로 표시하며 밝기 %를 nit로 환산하지 않습니다. 같은 %여도 모니터 모드에 따라 실제 휘도는 다를 수 있습니다." Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="20"/>
      <TextBlock Text="HDR이나 특정 화면 모드에서는 모니터가 밝기 변경을 제한할 수 있습니다. 통신 실패 시 모니터 OSD의 DDC/CI와 연결 상태를 확인하세요. 변경 명령은 표준 밝기(0x10)에 한정합니다." Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="20"/>
     </StackPanel></Expander></Border>
     <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0"><Expander x:Name="HelpGeneral" Header="실행 및 공통 단축키" Foreground="{DynamicResource Text}"><StackPanel Margin="0,12,0,0">
      <TextBlock Text="Ctrl + Alt + F11 · 설정 열기" TextWrapping="Wrap"/>
      <TextBlock x:Name="Shortcut" Text="Ctrl + Alt + F12 · 화면 보호 일시정지 / 재시작" Margin="0,8,0,0" TextWrapping="Wrap"/>
      <TextBlock Text="트레이 아이콘을 두 번 클릭해도 설정을 열 수 있습니다. X 버튼은 트레이로 숨기며, 완전히 종료하려면 ‘종료’를 사용하세요." Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="20"/>
      <TextBlock Text="‘로그인 시 자동 실행’을 켜면 저장한 설정으로 자동 감시를 시작합니다. 로그인하거나 EXE를 실행하면 설정 창 없이 트레이에서 시작하며 화면 보호는 약 3초 뒤 준비됩니다. EXE 옆의 settings.xml에 설정을 보관합니다." Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="20"/>
      <TextBlock Text="화면 캡처는 메모리에서만 비교하며 저장하거나 전송하지 않습니다. 화면 공유에는 검은 오버레이 대신 뒤쪽 내용이 보일 수 있습니다. DRM 영상·독점 전체 화면·보안 화면은 변화 감지가 제한될 수 있습니다. Windows 화면보호기·잠금·절전 중에는 조용히 대기하며, 복귀하면 감시를 재개하고 대기 시간을 처음부터 셉니다. 직접 일시정지하거나 설정 창을 열어 중지한 경우에는 자동 재개하지 않습니다." Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="20"/>
      <TextBlock Text="선택한 모니터의 연결이 끊겨도 감시 설정을 기억합니다. 다시 연결되면 자동으로 감시를 재개하고 대기 시간을 처음부터 셉니다. 연결된 다른 모니터의 감시는 계속됩니다. 시작할 때 대상이 없어도 연결을 기다립니다. Windows의 모니터 식별 정보로 대상을 찾으며, 다른 포트로 옮겨 식별 정보가 달라지면 한 번 다시 선택해야 할 수 있습니다." Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="20"/>
     </StackPanel></Expander></Border>
