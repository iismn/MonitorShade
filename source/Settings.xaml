        <Slider x:Name="MasterBrightness" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5" IsEnabled="False" AutomationProperties.Name="전체 밝기"/>
