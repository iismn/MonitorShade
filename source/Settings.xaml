        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0"><Button x:Name="MasterMinus" Content="−" Width="42" Height="42" Padding="0" Background="{DynamicResource Soft}" BorderThickness="0" AutomationProperties.Name="전체 밝기 낮추기"/><TextBox x:Name="MasterNumber" Width="78" Height="42" TextAlignment="Center" FontFamily="{DynamicResource NumberFont}" FontSize="16" MaxLength="3" Margin="12,0" AutomationProperties.Name="전체 밝기 직접 입력"/><Button x:Name="MasterPlus" Content="+" Width="42" Height="42" Padding="0" Background="{DynamicResource Soft}" BorderThickness="0" AutomationProperties.Name="전체 밝기 높이기"/></StackPanel>
